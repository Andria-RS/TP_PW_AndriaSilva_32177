{
  "info": {
    "name": "TP_PW_AndriaSilva_32177 API",
    "description": "Coleção Postman para testar a API REST do projeto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "albumId",
      "value": ""
    },
    {
      "key": "photoId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Registar utilizador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Utilizador Teste\",\n  \"email\": \"teste@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teste@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Utilizador autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Álbuns",
      "item": [
        {
          "name": "Listar álbuns públicos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/albums"
          }
        },
        {
          "name": "Pesquisar álbuns por tema",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/albums?theme=nature"
          }
        },
        {
          "name": "Listar os meus álbuns",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/albums/mine"
          }
        },
        {
          "name": "Criar álbum",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) pm.collectionVariables.set('albumId', data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Álbum de teste",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Álbum criado através do Postman",
                  "type": "text"
                },
                {
                  "key": "theme",
                  "value": "nature",
                  "type": "text"
                },
                {
                  "key": "isPublic",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "coverImage",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/albums"
          }
        },
        {
          "name": "Consultar álbum",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/albums/{{albumId}}"
          }
        },
        {
          "name": "Atualizar álbum",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Álbum atualizado",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Descrição atualizada",
                  "type": "text"
                },
                {
                  "key": "theme",
                  "value": "nature",
                  "type": "text"
                },
                {
                  "key": "isPublic",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/albums/{{albumId}}"
          }
        },
        {
          "name": "Eliminar álbum",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/albums/{{albumId}}"
          }
        }
      ]
    },
    {
      "name": "Fotografias",
      "item": [
        {
          "name": "Listar fotografias públicas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/photos"
          }
        },
        {
          "name": "Listar as minhas fotografias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/mine"
          }
        },
        {
          "name": "Criar fotografia",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) pm.collectionVariables.set('photoId', data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Fotografia de teste",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Fotografia criada através do Postman",
                  "type": "text"
                },
                {
                  "key": "albumId",
                  "value": "{{albumId}}",
                  "type": "text"
                },
                {
                  "key": "isPublic",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/photos"
          }
        },
        {
          "name": "Eliminar fotografia",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/{{photoId}}"
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Consultar likes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/likes/photo/{{photoId}}"
          }
        },
        {
          "name": "Adicionar ou alternar like",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/likes/photo/{{photoId}}"
          }
        },
        {
          "name": "Remover like",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/likes/photo/{{photoId}}"
          }
        }
      ]
    },
    {
      "name": "Comentários",
      "item": [
        {
          "name": "Listar comentários",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/comments/photo/{{photoId}}"
          }
        },
        {
          "name": "Criar comentário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data._id) pm.collectionVariables.set('commentId', data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Comentário criado através do Postman\"\n}"
            },
            "url": "{{baseUrl}}/comments/photo/{{photoId}}"
          }
        },
        {
          "name": "Editar comentário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Comentário atualizado\"\n}"
            },
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Eliminar comentário",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        }
      ]
    }
  ]
}